*.xlsx
*.xlsm
*.db
tests/fixtures/real/*
!tests/fixtures/real/expected.example.json
testdata/

# Excel の一時ファイル
~$*

# エディタ・OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 発注累計照会など実データを含むCSVも公開しない
*.csv
